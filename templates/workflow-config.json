{
  "planner": {
    "maxSessionMinutes": 60,
    "maxTicketsPerSession": 3,
    "analyticsReportPath": "src/data/analytics-report.json"
  },
  "validator": {
    "buildCommand": "npm run build",
    "contentDir": "src/content",
    "contentExtensions": [".md", ".mdx"],
    "requiredFrontmatterFields": ["title"],
    "checks": [
      "build",
      "frontmatter",
      "heading-hierarchy",
      "katex",
      "svg-blank-lines",
      "html-comments",
      "video-embeds",
      "internal-links",
      "no-placeholder",
      "empty-sections",
      "duplicate-content",
      "content-length",
      "companion-sync",
      "connected-categories",
      "language-conventions",
      "hardcoded-consistency"
    ],
    "companionSync": {
      "enabled": false,
      "supplementaryDir": "public/data",
      "supplementaryPattern": "{category}.json"
    },
    "connectedCategories": {
      "enabled": false,
      "filesToCheck": [
        "src/styles/global.css",
        "src/pages/index.astro"
      ]
    },
    "languageRules": {
      "_example-subject": {
        "language": "French",
        "requiredChars": ["e", "a", "c"],
        "commonErrors": {
          "wrong": "correct"
        }
      }
    },
    "contentLengthThreshold": 1500,
    "placeholderPhrases": [
      "coming soon",
      "placeholder",
      "check back",
      "TBD",
      "TODO",
      "work in progress",
      "under construction"
    ]
  },
  "uxReviewer": {
    "baseUrl": null,
    "devCommand": "npx astro dev",
    "port": 4322,
    "checks": [
      "console-errors",
      "broken-images",
      "layout-overflow",
      "katex",
      "mermaid",
      "placeholder-text",
      "grid-stretch",
      "raw-svg-text",
      "iframe-issues"
    ],
    "gridSelectors": [
      ".subjects-grid",
      ".features-row"
    ],
    "ignoredRequestPatterns": [
      "google-analytics.com",
      "googletagmanager.com",
      "/g/collect",
      "/pagefind/",
      "fonts.googleapis.com",
      "fonts.gstatic.com",
      "cdn.jsdelivr.net"
    ]
  },
  "feedbackSync": {
    "repo": "owner/repo",
    "label": "user-submitted",
    "syncedLabel": "synced-to-tkt"
  },
  "analytics": {
    "propertyId": "",
    "gscSiteUrl": "",
    "credentialsPath": ".ga-credentials.json",
    "outputPath": "src/data/analytics-report.json"
  },
  "digest": {
    "toEmail": [],
    "fromEmail": "",
    "projectName": "My Project",
    "analyticsPath": "src/data/analytics-report.json",
    "historyPath": "src/data/digest-history.json",
    "contentDir": "src/content"
  }
}
